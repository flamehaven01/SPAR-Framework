{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flamehaven01/SPAR-Framework/schemas/result.schema.json",
  "title": "SPAR Review Result",
  "type": "object",
  "required": [
    "subject",
    "gate",
    "score",
    "grade",
    "verdict",
    "claim_drift",
    "coverage_rate",
    "layer_a",
    "layer_b",
    "layer_c",
    "framework_declared"
  ],
  "properties": {
    "subject": {
      "description": "Stringified subject summary persisted by the review result."
    },
    "gate": {
      "type": "string"
    },
    "score": {
      "type": "integer"
    },
    "grade": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    },
    "claim_drift": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of absolute penalty weights from subject checks (Layer A/B/C). Excludes slop_penalty and framework_declared."
    },
    "coverage_rate": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Fraction of subject checks returning a determinate result (not CANNOT_CHECK). framework_declared excluded."
    },
    "slop_hits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_summary": {
      "type": [
        "object",
        "null"
      ],
      "description": "Safe contextual summary only. Raw MICA and LEDA payloads are not persisted."
    },
    "model_registry_snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "gap_registry_snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "layer_a": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "layer_b": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "layer_c": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "framework_declared": {
      "type": "array",
      "description": "Adapter-declared maturity or limitation surfaces that are not scored as subject-derived findings.",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "required": [
        "check_id",
        "label",
        "status",
        "detail",
        "ref",
        "basis",
        "scope"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "enum": [
            "subject_derived",
            "framework_declared"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "subject",
            "adapter_limitation"
          ],
          "description": "subject: check evaluates the reviewed subject. adapter_limitation: check declares a known limitation of the adapter itself."
        }
      }
    }
  }
}
